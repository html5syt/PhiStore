<Project Sdk="Godot.NET.Sdk/4.6.2">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- 禁用 SDK 自动生成的 AssemblyInfo，以避免重复的程序集属性 -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CodeAnalysisRuleSet>d:\Projects\Godot-Project\PhiStore\.vscode\ruleset.xml</CodeAnalysisRuleSet>
		<TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net10.0</TargetFramework>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<!-- 启用AOT -->
		<PublishAOT>true</PublishAOT>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootAssembly Include="GodotSharp" />
		<TrimmerRootAssembly Include="$(TargetName)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="PhigrosLabs.PhiInfo.Core" Version="4.0.0" />
		<PackageReference Include="PhigrosLabs.PhiInfo.Processing" Version="5.0.0" />
		<PackageReference Include="PhigrosLibraryCSharp" Version="4.2.0" />
		<PackageReference Include="Shua.Zip" Version="2.1.0" />
	</ItemGroup>
	<PropertyGroup>
 <Nullable>enable</Nullable>
</PropertyGroup>
</Project>
